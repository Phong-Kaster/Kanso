<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Beautify panel: the label of the strength slider, how much the skin is smoothed. Also what
         screen readers call the slider. Must never equal the tool's name, the screen's title. -->
    <string name="beautify_strength_label">Smoothing</string>
    <!-- A slider's current strength as a percentage, next to its label, for example "70%" (the
         Artistic panel's intensity). -->
    <string name="beautify_strength_value">%1$d%%</string>
    <!-- Beautify panel: the name of the Smooth tool in the row of tools, under its icon. Must never
         equal the tool's name, the screen's title. -->
    <string name="beautify_tool_smooth">Smooth</string>
    <!-- Beautify panel: the label of the face width slider, how much wider (negative) or narrower
         (positive) each face becomes. Also what screen readers call the slider. -->
    <string name="beautify_width_label">Face width</string>
    <!-- Beautify panel: the name of the Face group in the top row of tools, under its icon; tapping
         it shows the face tools (Width...). Must never equal the tool's name, the screen's title. -->
    <string name="beautify_group_face">Face</string>
    <!-- Beautify panel: the name of the Width tool in the Face group's row, under its icon (the
         group already says it is about the face). -->
    <string name="beautify_tool_width">Width</string>
    <!-- Beautify panel: the label of the face lift slider, how much the jawline of each face is
         raised and tightened (positive) or dropped (negative). Also what screen readers call the
         slider. -->
    <string name="beautify_lift_label">Face lift</string>
    <!-- Beautify panel: the name of the Lift tool in the Face group's row, under its icon (the
         group already says it is about the face). -->
    <string name="beautify_tool_lift">Lift</string>
    <!-- Beautify panel: the name of the Body group in the top row of tools, under its icon; tapping
         it shows the body tools (Waist...). Must never equal the tool's name, the screen's title. -->
    <string name="beautify_group_body">Body</string>
    <!-- Beautify panel: the name of the Waist tool in the Body group's row, under its icon. -->
    <string name="beautify_tool_waist">Waist</string>
    <!-- Beautify panel: the label of the waist slider, how much slimmer (positive) or wider
         (negative) each person's waist becomes. Also what screen readers call the slider. -->
    <string name="beautify_waist_label">Waist</string>
    <!-- Beautify panel: the name of the Arms tool in the Body group's row, under its icon. -->
    <string name="beautify_tool_arms">Arms</string>
    <!-- Beautify panel: the label of the arms slider, how much slimmer (positive) or thicker
         (negative) each person's arms become. Also what screen readers call the slider. -->
    <string name="beautify_arms_label">Arms</string>
    <!-- Beautify panel: the name of the Chest tool in the Body group's row, under its icon. -->
    <string name="beautify_tool_chest">Chest</string>
    <!-- Beautify panel: the label of the chest slider, how much fuller (positive) or flatter
         (negative) each person's chest becomes. Also what screen readers call the slider. -->
    <string name="beautify_chest_label">Chest</string>
    <!-- Beautify panel: the name of the Legs tool in the Body group's row, under its icon. -->
    <string name="beautify_tool_legs">Legs</string>
    <!-- Beautify panel: the label of the legs slider, how much slimmer (positive) or thicker
         (negative) each person's legs become. Also what screen readers call the slider. -->
    <string name="beautify_legs_label">Legs</string>
    <!-- Beautify panel: the name of the Temple tool in the Face group's row, under its icon. -->
    <string name="beautify_tool_temple">Temple</string>
    <!-- Beautify panel: the label of the temple slider, how much fuller (positive) or hollower
         (negative) each face's temples become. Also what screen readers call the slider. -->
    <string name="beautify_temple_label">Temple</string>
    <!-- Beautify panel: the name of the Cheekbones tool in the Face group's row, under its icon. -->
    <string name="beautify_tool_cheekbones">Cheekbones</string>
    <!-- Beautify panel: the label of the cheekbones slider, how much slimmer (positive) or wider (negative) each face becomes across the cheekbones. Also what screen readers call
         the slider. -->
    <string name="beautify_cheekbones_label">Cheekbones</string>
    <!-- Beautify panel: the name of the Chin length tool in the Face group's row, under its icon. -->
    <string name="beautify_tool_chin_length">Chin length</string>
    <!-- Beautify panel: the label of the chin length slider, how much shorter (positive) or longer (negative) each face's chin becomes. Also what screen readers call
         the slider. -->
    <string name="beautify_chin_length_label">Chin length</string>
    <!-- Beautify panel: the name of the Hairline tool in the Face group's row, under its icon. -->
    <string name="beautify_tool_hairline">Hairline</string>
    <!-- Beautify panel: the label of the hairline slider, how much lower (positive) or higher (negative) each face's hairline sits. Also what screen readers call
         the slider. -->
    <string name="beautify_hairline_label">Hairline</string>
</resources>
