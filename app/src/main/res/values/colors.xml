<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon: an enso ring around a lens. The default Kanso blue entry shows it in
         Google's four colours with a dark lens, on white; every other entry shows it in white on
         one of the backgrounds below. Which entry shows follows the theme colour (see LauncherIcon);
         each colour is one activity-alias in AndroidManifest.xml. They are dark enough for the
         white mark to read. -->
    <color name="ic_launcher_mark">#FFFFFFFF</color>
    <color name="ic_launcher_lens">#FF3C4043</color>
    <color name="ic_launcher_white">#FFFFFFFF</color>
    <color name="ic_launcher_google_blue">#FF4285F4</color>
    <color name="ic_launcher_google_red">#FFEA4335</color>
    <color name="ic_launcher_google_yellow">#FFFBBC04</color>
    <color name="ic_launcher_google_green">#FF34A853</color>
    <color name="ic_launcher_kanso_blue">#FF1A73E8</color>
    <color name="ic_launcher_teal">#FF00796B</color>
    <color name="ic_launcher_green">#FF2E7D32</color>
    <color name="ic_launcher_amber">#FFB26A00</color>
    <color name="ic_launcher_orange">#FFD84315</color>
    <color name="ic_launcher_red">#FFC62828</color>
    <color name="ic_launcher_pink">#FFAD1457</color>
    <color name="ic_launcher_purple">#FF6A1B9A</color>
    <color name="ic_launcher_ink">#FF14171F</color>
    <!-- Window background before Compose draws: the light background of Kanso blue, so there is no colour flash. -->
    <color name="window_background">#FFF9F9FF</color>
</resources>
