<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Retouch panel: the label of the strength slider, how much the skin is smoothed. Also what
         screen readers call the slider. Must never equal the tool's name, the screen's title. -->
    <string name="retouch_strength_label">Smoothing</string>
    <!-- Retouch panel: the slider's current strength as a percentage, next to its label, for
         example "70%". -->
    <string name="retouch_strength_value">%1$d%%</string>
    <!-- Retouch panel: the button that smooths the skin of the faces in the photo at the chosen
         strength. Must never equal the tool's name, the screen's title. -->
    <string name="retouch_run">Smooth skin</string>
</resources>
