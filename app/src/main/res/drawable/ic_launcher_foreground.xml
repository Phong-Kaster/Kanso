<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher mark in one colour, for the eight theme-colour entries and Ink: the same enso ring
     and lens as ic_launcher_foreground_google.xml, in white on the coloured background.
     The 108dp canvas keeps the mark inside the 66dp safe zone that every icon shape shows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="@color/ic_launcher_mark"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M73.94,44.7 A22,22 0 1,1 61.52,33.33" />
    <path
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M46.5,54 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 Z" />
</vector>
