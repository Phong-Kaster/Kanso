<?xml version="1.0" encoding="utf-8"?>
<!-- A plain mark for the launcher icon: one open circle (an enso, the Zen brush circle). The
     108dp canvas keeps the mark inside the 66dp safe zone that every icon shape shows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M68,38 A22,22 0 1,0 74,52"
        android:strokeWidth="5"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
