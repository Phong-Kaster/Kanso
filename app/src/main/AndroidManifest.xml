<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kanso works offline. Engine libraries (ML Kit) merge these in; remove them. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Photo access for the gallery: Android 14+ asks for the first two (the second lets the user
         share only some photos), Android 13 for READ_MEDIA_IMAGES, Android 12 and older for
         READ_EXTERNAL_STORAGE, which stops mattering from Android 13 (maxSdkVersion 32). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- The camera screen takes photos; Save writes into Pictures/Kanso, which needs the old
         storage-write permission only up to Android 9 (API 28). The camera is not required, so
         the app still installs on a phone without one (the camera tile then just cannot shoot). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Engine libraries (WorkManager, old TensorFlow Lite) merge these in; Kanso does not use them. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />

    <!-- enableOnBackInvokedCallback switches on predictive back: the system lets the app handle the
         back gesture itself, so on Android 14 and later Navigation 3 can show the screen
         underneath while the finger is still moving and cancel if the finger lets go early.
         Android 13 takes Back through the same callback but sends no progress, and older versions
         ignore the attribute, which tools:targetApi tells the build. -->
    <application
        android:name=".KansoApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher_kanso_blue"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_kanso_blue"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kanso">

        <!-- The one activity. It starts with the system splash theme and switches to
             Theme.Kanso once installSplashScreen() runs. It is exported so IDEs and ADB can
             launch it directly even when LauncherKansoBlue or other icon aliases are disabled. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="com.phongkaster.kanso.main"
            android:theme="@style/Theme.Kanso.Starting" />

        <!-- What every launcher entry opens: it starts MainActivity in MainActivity's own task
             (taskAffinity above) and closes, so switching a launcher entry off never closes
             MainActivity (see LauncherActivity). Its empty taskAffinity gives it a throwaway task
             of its own, kept out of Recents. It carries the launch theme so the system splash
             still shows the icon. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kanso.Starting" />

        <!-- One launcher entry per icon colour. Exactly one is enabled
             at a time: LauncherIconSwitcher enables the one closest to the theme colour and
             disables the rest. They open LauncherActivity, which hands over to MainActivity. Kanso blue, the default theme colour, is the one a fresh install
             shows. The names are on users' launchers; never rename them. -->
        <activity-alias
            android:name=".LauncherKansoBlue"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_kanso_blue"
            android:roundIcon="@mipmap/ic_launcher_kanso_blue"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:roundIcon="@mipmap/ic_launcher_teal"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pink"
            android:roundIcon="@mipmap/ic_launcher_pink"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPurple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherInk"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink"
            android:roundIcon="@mipmap/ic_launcher_ink"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Share hands the rendered picture to another app through this provider: a copy in the
             cache's shared/ folder, readable only by the app that receives the grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
