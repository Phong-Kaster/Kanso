+            hue < MIN_BLUE_HUE || hue > MAX_BLUE_HUE ->
+                "$name ${hex(colour)} has hue $hue, outside $MIN_BLUE_HUE..$MAX_BLUE_HUE"
+            blue <= red || blue <= green ->
