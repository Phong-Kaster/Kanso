+        // A grey has no hue; 0 keeps it outside the blue range.
+        if (delta == 0.0) return 0.0
+        val hue = when (max) {
+            red -> 60.0 * (((green - blue) / delta) % 6.0)
+            green -> 60.0 * ((blue - red) / delta + 2.0)
+            else -> 60.0 * ((red - green) / delta + 4.0)
+        }
+        return if (hue < 0.0) hue + 360.0 else hue
+    }
