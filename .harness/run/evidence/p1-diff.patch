+                enabled = state.photo is ToolUiState.PhotoState.Ready && !saving,
+                contentPadding = ButtonDefaults.ButtonWithIconContentPadding,
+                modifier = Modifier
+                    .padding(end = 8.dp)
+                    .heightIn(min = 48.dp)
+                    .testTag(TOOL_SAVE_TAG),
+            ) {
+                if (saving) {
+                    CircularProgressIndicator(
+                        modifier = Modifier
