+                id = (i + 1).toLong(),
+                uri = "$FAKE_SCHEME://color/${"%08X".format(argb)}",
+                name = "photo_${i + 1}.jpg",
+                albumId = ALBUMS[i % ALBUMS.size].id,
+                modifiedSeconds = 1_700_000_000L - i * 3_600L,
