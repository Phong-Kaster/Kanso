+        modifier = modifier
+            .clip(shape)
+            .drawBehind {
+                drawRect(color = base)
+                // Read here, in the draw phase: a new phase repaints this block and nothing else.
+                val bandWidth = size.width * BAND_WIDTH_FRACTION
