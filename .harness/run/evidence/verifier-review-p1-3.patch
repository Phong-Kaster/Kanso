+                    brush = Brush.horizontalGradient(
+                        0f to band.copy(alpha = 0f),
+                        0.5f to band,
+                        1f to band.copy(alpha = 0f),
+                        startX = bandStart,
+                        endX = bandStart + bandWidth,
+                    ),
+                )
+            },
