+    }
+
+    /**
+     * Android 8.1 with photo access granted: exactly the five Kanso photos, newest first, found by
+     * the file path (`_data`), since the table has no `relative_path` column before Android 10.
+     */
+    @Test
+    @Config(sdk = [27])
