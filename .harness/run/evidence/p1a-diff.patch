+    @OptIn(ExperimentalLayoutApi::class)
+    @Composable
+    private fun Probe() {
+        val view = LocalView.current
+        val keyboard = WindowInsets.isImeVisible
+        val clearance = tabBarClearance()
+        SideEffect {
+            composeView = view
+            keyboardSeen = keyboard
+            clearanceSeen = clearance
+        }
