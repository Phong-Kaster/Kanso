+    private fun show(
+        state: MyEditsUiState,
+        contentPadding: PaddingValues = PaddingValues(),
+        onPhotoClick: (String) -> Unit = {},
+    ) {
+        compose.setContent {
+            KansoTheme(themeMode = ThemeMode.Light) {
+                MyEditsContent(
+                    state = state,
+                    onPhotoClick = onPhotoClick,
+                    contentPadding = contentPadding,
+                    thumbnail = standIn,
+                )
+            }
+        }
+        compose.waitForIdle()
+    }
+
+    /**
+     * Returns the photo tiles laid out on screen, in reading order: top row first, left to right
+     * in each row. Tiles built ahead of scrolling but not placed are left out.
+     */
+    private fun placedTilesInReadingOrder(): List<SemanticsNode> =
+        compose.onAllNodes(isTile).fetchSemanticsNodes()
+            .filter { it.layoutInfo.isPlaced }
+            .sortedWith(compareBy<SemanticsNode>({ it.positionInRoot.y }, { it.positionInRoot.x }))
+
+    /** Returns the spoken name the screen should give [photo]'s tile. */
+    private fun expectedName(photo: Photo): String =
+        app.getString(R.string.my_edits_photo_description, savedAtText(photo.modifiedSeconds))
+
+    /**
+     * Draws the activity's content view into a fresh bitmap, hands it to [read], then frees it.
+     * The Compose root fills the content view from its top-left corner, so a node's
+     * `boundsInRoot` are the bitmap's coordinates.
+     */
+    private fun <T> drawScreen(read: (Bitmap) -> T): T {
+        val content = compose.activity.findViewById<ViewGroup>(android.R.id.content)
+        val view = content.getChildAt(0) ?: error("The activity has no content view yet")
+        check(view.width > 0 && view.height > 0) { "The content view is not laid out yet" }
+        val bitmap = Bitmap.createBitmap(view.width, view.height, Bitmap.Config.ARGB_8888)
+        return try {
+            view.draw(Canvas(bitmap))
+            read(bitmap)
+        } finally {
+            // A bitmap holds native memory; free it now rather than waiting for the collector.
+            bitmap.recycle()
+        }
+    }
+
+    /** Tells whether the red, green and blue of [a] and [b] each differ by at most [COLOUR_TOLERANCE]. */
+    private fun near(a: Int, b: Int): Boolean =
+        abs(android.graphics.Color.red(a) - android.graphics.Color.red(b)) <= COLOUR_TOLERANCE &&
+            abs(android.graphics.Color.green(a) - android.graphics.Color.green(b)) <= COLOUR_TOLERANCE &&
+            abs(android.graphics.Color.blue(a) - android.graphics.Color.blue(b)) <= COLOUR_TOLERANCE
+
+    /** Writes [colour] as `#AARRGGBB`, for failure messages. */
+    private fun hex(colour: Int): String = "#%08X".format(colour)
+
+    /** Values, photos and matchers the tests share. */
+    private companion object {
+        /** How long to wait for the fake source's read to end, in milliseconds. */
+        const val LOAD_TIMEOUT_MS = 5_000L
+
+        /** The bottom padding the scroll test gives, in dp: about the floating bar's clearance. */
+        const val BOTTOM_PADDING_DP = 120
+
+        /** The largest difference per colour channel still counted as the same colour. */
+        const val COLOUR_TOLERANCE = 8
+
+        /** The solid colour of tile 0's stand-in picture: a soft red, far from any theme surface. */
+        const val TILE_ZERO_COLOUR = 0xFFD97777.toInt()
+
+        /** The time of the newest sample photo, in seconds since 1970 (October 2026). */
+        const val NEWEST_SECONDS = 1_791_800_000L
+
+        /** Matches every photo tile, whatever its place. */
+        val isTile = SemanticsMatcher("is a My edits photo tile") { node ->
+            node.config.getOrNull(SemanticsProperties.TestTag)?.startsWith(MY_EDITS_TILE_TAG_PREFIX) == true
+        }
+
+        /** Matches every skeleton tile, whatever its place. */
+        val isSkeleton = SemanticsMatcher("is a My edits skeleton tile") { node ->
+            node.config.getOrNull(SemanticsProperties.TestTag)?.startsWith(MY_EDITS_SKELETON_TAG_PREFIX) == true
+        }
+
+        /**
+         * The stand-in for a tile's picture: a solid colour drawn with the tile's modifier. Photo
+         * 1 (the newest, tile 0) is [TILE_ZERO_COLOUR]; the others are a soft indigo.
+         */
+        val standIn: @Composable (Photo, Modifier) -> Unit = { photo, tileModifier ->
+            val colour = if (photo.id == 1L) TILE_ZERO_COLOUR else 0xFF5C6BC0.toInt()
+            Spacer(modifier = tileModifier.background(Color(colour)))
+        }
+
+        /** Returns [count] saved photos, newest first (photo 1 is the newest), one hour apart. */
+        fun photos(count: Int): List<Photo> = (1..count).map { i ->
+            Photo(
+                id = i.toLong(),
+                uri = "content://media/external/images/media/$i",
+                name = "Kanso_$i.jpg",
+                albumId = 1L,
+                modifiedSeconds = NEWEST_SECONDS - i * 3_600L,
+            )
+        }
+    }
+}
diff --git a/app/src/test/java/com/phongkaster/kanso/myedits/MyEditsViewModelTest.kt b/app/src/test/java/com/phongkaster/kanso/myedits/MyEditsViewModelTest.kt
new file mode 100644
index 0000000..18fa86c
--- /dev/null
+++ b/app/src/test/java/com/phongkaster/kanso/myedits/MyEditsViewModelTest.kt
@@ -0,0 +1,157 @@
+package com.phongkaster.kanso.myedits
+
+import android.os.Looper
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import com.phongkaster.kanso.data.media.Photo
+import com.phongkaster.kanso.di.ViewModelClearedProbe
+import com.phongkaster.kanso.ui.myedits.MyEditsUiState
+import com.phongkaster.kanso.ui.myedits.MyEditsViewModel
+import java.io.IOException
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.koin.core.context.stopKoin
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+/**
+ * Checks the My edits ViewModel on its own, with no screen drawn (DoD 9): it starts as loading,
+ * lists the saved photos newest first, picks up a photo saved since the last read, and shows the
+ * empty state (never an error) when the source has nothing or fails.
+ *
+ * It runs under Robolectric, on Android's main thread, the thread the ViewModel's coroutines run
+ * on: a read whose fake source answers at once has finished when `refresh` returns, and the main
+ * thread's queue is still run afterwards so nothing waiting there is missed.
+ */
+@RunWith(AndroidJUnit4::class)
+@Config(sdk = [35])
+class MyEditsViewModelTest {
+
+    /**
+     * Stops Koin after each test: KansoApplication starts it for every Robolectric test, and its
+     * state outlives the test inside the same JVM.
+     */
+    @After
+    fun stopKoinAfterTest() {
+        stopKoin()
+    }
+
+    /** Before the first read the state is loading, with no photos. */
+    @Test
+    fun the_state_starts_as_loading_with_no_photos() {
+        val viewModel = myEditsViewModel(FakeSavedPhotoSource(photos(3)))
+
+        assertEquals(MyEditsUiState(photos = emptyList(), loading = true), viewModel.state.value)
+    }
+
+    /** The photos are listed newest first, whatever order the source gives them in. */
+    @Test
+    fun photos_are_listed_newest_first() {
+        val photos = photos(5)
+        // Out of order on purpose: the oldest first, the newest in the middle.
+        val given = listOf(photos[4], photos[2], photos[0], photos[3], photos[1])
+        val viewModel = myEditsViewModel(FakeSavedPhotoSource(given))
+
+        viewModel.refresh()
+        runMainThread()
+
+        val state = viewModel.state.value
+        assertEquals(false, state.loading)
+        assertEquals(photos.sortedByDescending { it.modifiedSeconds }.map { it.id }, state.photos.map { it.id })
+    }
+
+    /** A photo saved after the first read is listed, first, by the next refresh. */
+    @Test
+    fun refresh_picks_up_a_newly_saved_photo() {
+        val source = FakeSavedPhotoSource(photos(3))
+        val viewModel = myEditsViewModel(source)
+        viewModel.refresh()
+        runMainThread()
+        assertEquals(3, viewModel.state.value.photos.size)
+
+        val saved = photo(id = 99L, modifiedSeconds = NEWEST_SECONDS + 600L)
+        source.photos = source.photos + saved
+        viewModel.refresh()
+        runMainThread()
+
+        val state = viewModel.state.value
+        assertEquals(4, state.photos.size)
+        assertEquals(saved, state.photos.first())
+        assertEquals(2, source.reads.get())
+    }
+
+    /** While a second read runs, the photos already shown stay, marked as loading. */
+    @Test
+    fun photos_stay_on_screen_while_a_new_read_runs() {
+        val source = FakeSavedPhotoSource(photos(3))
+        val viewModel = myEditsViewModel(source)
+        viewModel.refresh()
+        runMainThread()
+
+        source.holdReads()
+        viewModel.refresh()
+        runMainThread()
+        val during = viewModel.state.value
+        assertTrue("The second read should still be running", during.loading)
+        assertEquals(3, during.photos.size)
+
+        source.releaseReads()
+        runMainThread()
+        assertEquals(false, viewModel.state.value.loading)
+    }
+
+    /** A source with no saved photo gives the empty state: no photos, not loading. */
+    @Test
+    fun an_empty_source_gives_the_empty_state() {
+        val viewModel = myEditsViewModel(FakeSavedPhotoSource(emptyList()))
+
+        viewModel.refresh()
+        runMainThread()
+
+        assertEquals(MyEditsUiState(photos = emptyList(), loading = false), viewModel.state.value)
+    }
+
+    /** A source that throws gives the empty state too, never a crash. */
+    @Test
+    fun a_source_that_throws_gives_the_empty_state() {
+        val source = FakeSavedPhotoSource(photos(3)).apply { failure = IOException("no library") }
+        val viewModel = myEditsViewModel(source)
+
+        viewModel.refresh()
+        runMainThread()
+
+        assertEquals(MyEditsUiState(photos = emptyList(), loading = false), viewModel.state.value)
+    }
+
+    // --- Helpers -----------------------------------------------------------------------------
+
+    /** Builds the ViewModel with [source], the way the app's Koin recipe does but by hand. */
+    private fun myEditsViewModel(source: FakeSavedPhotoSource): MyEditsViewModel =
+        MyEditsViewModel(savedPhotos = source, probe = ViewModelClearedProbe())
+
+    /** Runs everything waiting in the main thread's queue, where the ViewModel's read ends. */
+    private fun runMainThread() {
+        shadowOf(Looper.getMainLooper()).idle()
+    }
+
+    /** Values and photos shared by the tests. */
+    private companion object {
+        /** The time of the newest sample photo, in seconds since 1970 (October 2026). */
+        const val NEWEST_SECONDS = 1_791_800_000L
+
+        /** Returns [count] saved photos, newest first, one hour apart. */
+        fun photos(count: Int): List<Photo> =
+            (1..count).map { i -> photo(id = i.toLong(), modifiedSeconds = NEWEST_SECONDS - i * 3_600L) }
+
+        /** Returns one saved photo with [id], changed at [modifiedSeconds]. */
+        fun photo(id: Long, modifiedSeconds: Long): Photo = Photo(
+            id = id,
+            uri = "content://media/external/images/media/$id",
+            name = "Kanso_$id.jpg",
+            albumId = 1L,
+            modifiedSeconds = modifiedSeconds,
+        )
+    }
+}
diff --git a/app/src/test/java/com/phongkaster/kanso/myedits/RecordingMediaProvider.kt b/app/src/test/java/com/phongkaster/kanso/myedits/RecordingMediaProvider.kt
new file mode 100644
index 0000000..937432a
--- /dev/null
+++ b/app/src/test/java/com/phongkaster/kanso/myedits/RecordingMediaProvider.kt
@@ -0,0 +1,211 @@
+package com.phongkaster.kanso.myedits
+
+import android.Manifest
+import android.content.ContentProvider
+import android.content.ContentUris
+import android.content.ContentValues
+import android.content.pm.PackageManager
+import android.database.Cursor
+import android.database.sqlite.SQLiteDatabase
+import android.net.Uri
+import android.os.Build
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.CopyOnWriteArrayList
+import org.robolectric.Robolectric
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.shadows.ShadowContentResolver
+
+/**
+ * A stand-in for Android's MediaStore (the `media` content provider) that really applies the
+ * selection and the sort order it is given, and records every query, insert, update and delete.
+ *
+ * Robolectric has no MediaStore of its own. The older [com.phongkaster.kanso.save.FakeMediaProvider]
+ * ignores a query's selection, which is fine for the saver but would prove nothing about a reader
+ * that depends on its selection. This one keeps its rows in an in-memory SQLite table (the same
+ * database engine the real MediaStore uses) and hands each query's selection, arguments and sort
+ * order to SQLite as they are, so a wrong folder filter or a wrong order gives a wrong answer.
+ *
+ * It copies two facts of the real provider that matter to Kanso:
+ *
+ * - Before Android 10 the table has no `relative_path` column (only the file path in `_data`),
+ *   so a query that names `relative_path` there fails, as it would on the phone.
+ * - Before Android 10 reading needs the photo-read permission: without it a query throws a
+ *   SecurityException. Robolectric starts with every permission refused; a test grants it with
+ *   `shadowOf(application).grantPermissions(...)`.
+ *
+ * Inserts are accepted (so [com.phongkaster.kanso.data.photo.MediaStorePhotoSaver] can save into
+ * it): a new row gets `date_modified` = now when the saver gives none, as MediaStore does, and its
+ * bytes go to an in-memory stream. Every Uri of the `media` authority reaches the same one table.
+ */
+class RecordingMediaProvider : ContentProvider() {
+
+    /** One query as the provider received it. */
+    class Query(
+        val uri: Uri,
+        val projection: List<String>?,
+        val selection: String?,
+        val selectionArgs: List<String>?,
+        val sortOrder: String?,
+    )
+
+    /** Every query, oldest first. */
+    val queries = CopyOnWriteArrayList<Query>()
+
+    /** The values of every insert, exactly as given, oldest first. */
+    val inserts = CopyOnWriteArrayList<ContentValues>()
+
+    /** Every update, as (row Uri, values given), oldest first. */
+    val updates = CopyOnWriteArrayList<Pair<Uri, ContentValues>>()
+
+    /** The Uris of every delete, oldest first. */
+    val deletes = CopyOnWriteArrayList<Uri>()
+
+    /** The in-memory table of images. */
+    private lateinit var database: SQLiteDatabase
+
+    /** True when the table has MediaStore's Android 10 column `relative_path`. */
+    private val hasRelativePath: Boolean
+        get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+
+    /** Makes the empty in-memory table, with the columns of the running Android version. */
+    override fun onCreate(): Boolean {
+        database = SQLiteDatabase.create(null)
+        val relativePath = if (hasRelativePath) ", $RELATIVE_PATH TEXT" else ""
+        database.execSQL(
+            "CREATE TABLE $TABLE (" +
+                "$ID INTEGER PRIMARY KEY AUTOINCREMENT, " +
+                "$DISPLAY_NAME TEXT, $MIME_TYPE TEXT, $DATA TEXT, $BUCKET_ID INTEGER, " +
+                "$DATE_MODIFIED INTEGER, $IS_PENDING INTEGER DEFAULT 0$relativePath)",
+        )
+        return true
+    }
+
+    /**
+     * Puts a photo named [name] in [folder] (for example `Pictures/Kanso/`), changed at
+     * [modifiedSeconds], straight into the table, as if another app or an earlier save had made
+     * it. It is not recorded as an insert. Returns the new row's id.
+     */
+    fun addPhoto(name: String, folder: String, modifiedSeconds: Long): Long {
+        val values = ContentValues().apply {
+            put(DISPLAY_NAME, name)
+            put(MIME_TYPE, "image/jpeg")
+            put(DATA, "$STORAGE_ROOT/$folder$name")
+            put(BUCKET_ID, folder.hashCode().toLong())
+            put(DATE_MODIFIED, modifiedSeconds)
+            if (hasRelativePath) put(RELATIVE_PATH, folder)
+        }
+        return database.insertOrThrow(TABLE, null, values)
+    }
+
+    /**
+     * Records the query, refuses it before Android 10 without the photo-read permission, and
+     * otherwise runs it on the table with the given selection, arguments and sort order.
+     */
+    override fun query(
+        uri: Uri,
+        projection: Array<out String>?,
+        selection: String?,
+        selectionArgs: Array<out String>?,
+        sortOrder: String?,
+    ): Cursor {
+        queries += Query(uri, projection?.toList(), selection, selectionArgs?.toList(), sortOrder)
+        val app = RuntimeEnvironment.getApplication()
+        if (!hasRelativePath &&
+            app.checkSelfPermission(Manifest.permission.READ_EXTERNAL_STORAGE) != PackageManager.PERMISSION_GRANTED
+        ) {
+            throw SecurityException("Reading media needs READ_EXTERNAL_STORAGE before Android 10")
+        }
+        return database.query(
+            TABLE,
+            projection?.map { it }?.toTypedArray(),
+            selection,
+            selectionArgs?.map { it }?.toTypedArray(),
+            null,
+            null,
+            sortOrder,
+        )
+    }
+
+    /** Records the insert, adds the row and lets the app's resolver write the row's bytes. */
+    override fun insert(uri: Uri, values: ContentValues?): Uri {
+        val given = ContentValues(values ?: ContentValues())
+        inserts += ContentValues(given)
+        val row = ContentValues(given)
+        // MediaStore stamps a new row with the time it was made.
+        if (!row.containsKey(DATE_MODIFIED)) row.put(DATE_MODIFIED, System.currentTimeMillis() / 1_000L)
+        val id = database.insertOrThrow(TABLE, null, row)
+        val rowUri = ContentUris.withAppendedId(uri, id)
+        // Robolectric's ContentResolver hands out output streams from its own table, not from the
+        // provider, so the new row's stream is registered there.
+        shadowOf(RuntimeEnvironment.getApplication().contentResolver)
+            .registerOutputStreamSupplier(rowUri) { ByteArrayOutputStream() }
+        return rowUri
+    }
+
+    /** Records the update and changes the values of the row [uri] names. */
+    override fun update(
+        uri: Uri,
+        values: ContentValues?,
+        selection: String?,
+        selectionArgs: Array<out String>?,
+    ): Int {
+        val given = ContentValues(values ?: ContentValues())
+        updates += uri to given
+        return database.update(TABLE, given, "$ID = ?", arrayOf(ContentUris.parseId(uri).toString()))
+    }
+
+    /** Records the delete and removes the row [uri] names. */
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int {
+        deletes += uri
+        return database.delete(TABLE, "$ID = ?", arrayOf(ContentUris.parseId(uri).toString()))
+    }
+
+    /** Every row of this provider holds a JPEG. */
+    override fun getType(uri: Uri): String = "image/jpeg"
+
+    /** The table's name and columns (MediaStore's own column names) and the helper to install it. */
+    companion object {
+        /** The one table every Uri reaches. */
+        private const val TABLE = "images"
+
+        /** The row id column. */
+        const val ID = "_id"
+
+        /** The file name column. */
+        const val DISPLAY_NAME = "_display_name"
+
+        /** The file type column. */
+        const val MIME_TYPE = "mime_type"
+
+        /** The full file path column (the only folder information before Android 10). */
+        const val DATA = "_data"
+
+        /** The album (bucket) column. */
+        const val BUCKET_ID = "bucket_id"
+
+        /** The last-changed time column, in seconds since 1970. */
+        const val DATE_MODIFIED = "date_modified"
+
+        /** The "still being written" mark, Android 10 and later. */
+        const val IS_PENDING = "is_pending"
+
+        /** The folder column, Android 10 and later. */
+        const val RELATIVE_PATH = "relative_path"
+
+        /** Where shared storage starts on a phone, the start of every `_data` path. */
+        const val STORAGE_ROOT = "/storage/emulated/0"
+
+        /**
+         * Builds the provider and registers it as the `media` provider of the app's
+         * ContentResolver for the rest of the test.
+         */
+        fun install(): RecordingMediaProvider {
+            val provider = Robolectric.buildContentProvider(RecordingMediaProvider::class.java)
+                .create("media")
+                .get()
+            ShadowContentResolver.registerProviderInternal("media", provider)
+            return provider
+        }
+    }
+}
diff --git a/app/src/test/java/com/phongkaster/kanso/navigation/BackStackActionsTest.kt b/app/src/test/java/com/phongkaster/kanso/navigation/BackStackActionsTest.kt
